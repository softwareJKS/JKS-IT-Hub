# ==============================================================================
# JKS-IT-Hub Production Environment Variables for Dokploy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reverse Proxy & Domain Routing
# ------------------------------------------------------------------------------
# Host ports exposed on 192.168.78.61:
WEB_PORT=5175
API_PORT=5001

# Public URL used by the browser to reach the API (baked into frontend build)
VITE_API_BASE_URL=https://it-api.jkseng.com

# Public URL used in email templates and links
APP_URL=https://it.jkseng.com

# CORS allowed origin (allows browser requests from frontend to API)
CORS_ORIGIN=https://it.jkseng.com

# Fastify reverse proxy trust (enables accurate client IP and protocol detection)
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 2. Database Connection (External MySQL)
# ------------------------------------------------------------------------------
# Replace with credentials of your external or Dokploy-managed MySQL instance:
DATABASE_URL="mysql://it_hub:your_mysql_password@192.168.78.61:3306/it_hub"
MYSQL_ROOT_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret keys (generate random strings with: openssl rand -hex 32)
JWT_SECRET=replace-with-32-plus-character-random-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-plus-character-random-secret

JWT_ISSUER=it-hub
JWT_AUDIENCE=it-hub-web
JWT_EXPIRES_IN=12h

# Cookie configuration for cross-subdomain authentication
AUTH_COOKIE_NAME=it-hub-session
AUTH_COOKIE_SECURE=true
# Optional: Set domain to .jkseng.com if you want cookie shared across subdomains
AUTH_COOKIE_DOMAIN=.jkseng.com
AUTH_COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 4. LDAP / Active Directory Configuration
# ------------------------------------------------------------------------------
LDAP_URL="ldaps://ldap.jkseng.com:636"
LDAP_BASE_DN="dc=jkseng,dc=com"
LDAP_BIND_DN="cn=bind-user,dc=jkseng,dc=com"
LDAP_BIND_PASSWORD="change-me"
LDAP_USER_FILTER="(sAMAccountName={{username}})"
LDAP_SYNC_FILTER="(objectClass=person)"
LDAP_SYNC_ATTRIBUTES="sAMAccountName,cn,givenName,sn,mail,employeeNumber,department,title,telephoneNumber,birthDate"
LDAP_SYNC_USERNAME_ATTRIBUTE="sAMAccountName"
LDAP_SYNC_EXCLUDE_USERNAME_REGEX=""
LDAP_SYNC_PAGE_SIZE=500
LDAP_USE_STARTTLS=false
LDAP_TLS_CA_PATH=""
LDAP_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 5. Marketplace Scraper Service (Internal)
# ------------------------------------------------------------------------------
SCRAPER_ENABLED=true
SCRAPER_BASE_URL=http://scraper:3016
SCRAPER_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 6. Maintenance & Scheduled Jobs
# ------------------------------------------------------------------------------
MAINTENANCE_SCHEDULE_ENABLED=true
MAINTENANCE_SCHEDULE_CRON="0 0 * * *"
MAINTENANCE_SCHEDULE_TIMEZONE="Asia/Kuala_Lumpur"
MAINTENANCE_SCHEDULE_RETRY_ATTEMPTS=3
MAINTENANCE_SCHEDULE_RETRY_DELAY_MS=1000

# ------------------------------------------------------------------------------
# 7. Optional Integrations (JKSPulse & Snipe-IT)
# ------------------------------------------------------------------------------
PULSE_ORG_SYNC_ENABLED=false
PULSE_MONGO_URI=""
PULSE_MONGO_DATABASE="jkspulse"
PULSE_MONGO_TIMEOUT_MS=2000

SNIPE_IT_BASE_URL=""
SNIPE_IT_API_TOKEN=""
SNIPE_IT_SYNC_ENABLED=false
SNIPE_IT_SYNC_CRON="0 */6 * * *"
SNIPE_IT_SYNC_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 8. Email Notifications (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.jkseng.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IT-Hub <noreply@jkseng.com>"
